# -----------------------------------------------------------------------------
# Server Config
# -----------------------------------------------------------------------------
PORT=4000

# -----------------------------------------------------------------------------
# AI Extraction (Gemini)
# -----------------------------------------------------------------------------
# Required: Your Gemini API Key for vision extraction
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.0-flash"

# -----------------------------------------------------------------------------
# On-Chain / Relayer Config
# -----------------------------------------------------------------------------
# Target Chain (Base Sepolia preferred: 84532, Sepolia fallback: 11155111)
CHAIN_ID=84532
RPC_URL="https://sepolia.base.org"

# Contract addresses (copy these from the Foundry Deploy.s.sol output)
CONTRACT_ADDRESS="0x..."
PAYMENT_TOKEN_ADDRESS="0x..."

# -----------------------------------------------------------------------------
# Private Keys
# -----------------------------------------------------------------------------
# ORACLE_PRIVATE_KEY: Used by src/signer/attestation.js to EIP-712 sign verdicts
ORACLE_PRIVATE_KEY="0x..."

# RELAYER_PRIVATE_KEY: Used by src/chain/submit.js to pay gas for verifyAndAdvance()
# For the demo, this can be the same as your deployer/procuring entity key
RELAYER_PRIVATE_KEY="0x..."

# -----------------------------------------------------------------------------
# Demo Public Addresses (for frontend dashboard reference / debugging)
# -----------------------------------------------------------------------------
ORACLE_SIGNER_ADDRESS="0x..."
VENDOR_ADDRESS="0x..."
PROCURING_ENTITY_ADDRESS="0x..."